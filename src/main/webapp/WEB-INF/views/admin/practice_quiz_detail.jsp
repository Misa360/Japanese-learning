<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Chi tiết bộ luyện đề" scope="request"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<jsp:include page="/WEB-INF/views/partials/admin_header.jsp"/>
<main class="jl-container jl-user-layout">
  <div class="jl-admin-detail-top"><a href="${ctx}/admin/quizzes?type=practice">← Danh sách Luyện đề</a><a class="jl-btn jl-btn-outline" href="${ctx}/admin/quizzes/${quiz.id}/edit?type=practice">Chỉnh sửa bộ đề</a></div>
  <header class="jl-page-header"><div><span class="jl-chip jl-chip-level"><c:out value="${quiz.levelCode}"/></span><h1><c:out value="${quiz.title}"/></h1><p class="jl-muted"><c:out value="${quiz.description}"/></p></div><span class="jl-admin-status ${quiz.status == 'published' ? 'jl-admin-status-published' : ''}"><c:out value="${quiz.status}"/></span></header>
  <div class="jl-admin-practice-stats"><div class="jl-card"><strong><c:out value="${quiz.sectionCount}"/></strong><span>Phần luyện</span></div><div class="jl-card"><strong><c:out value="${quiz.questionCount}"/></strong><span>Câu hỏi</span></div><div class="jl-card"><strong><fmt:formatNumber value="${quiz.attemptCount}" groupingUsed="true"/></strong><span>Lượt làm</span></div><div class="jl-card"><strong><c:choose><c:when test="${not empty quiz.timeLimitSeconds}"><fmt:formatNumber value="${quiz.timeLimitSeconds / 60}" maxFractionDigits="0"/> phút</c:when><c:otherwise>Không giới hạn</c:otherwise></c:choose></strong><span>Thời gian</span></div></div>
  <div class="jl-admin-section-heading"><div><h2>Phần luyện</h2><p class="jl-muted">Chia câu hỏi thành Từ vựng, Chữ Hán, Ngữ pháp hoặc các phần khác.</p></div><a class="jl-btn" href="${ctx}/admin/quiz-sections/new?type=practice&amp;quiz_id=${quiz.id}">＋ Thêm phần</a></div>
  <div class="jl-admin-lesson-list"><c:forEach var="section" items="${sections}"><a class="jl-card jl-admin-lesson-row" href="${ctx}/admin/quiz-sections/${section.id}?type=practice&amp;quiz_id=${quiz.id}"><span class="jl-admin-lesson-number"><c:out value="${section.sortOrder}"/></span><span class="jl-admin-lesson-info"><strong><c:out value="${section.title}"/></strong><small><c:out value="${section.questionCount}"/> câu hỏi<c:if test="${not empty section.timeLimitSeconds}"> · <fmt:formatNumber value="${section.timeLimitSeconds / 60}" maxFractionDigits="0"/> phút</c:if></small></span><span class="jl-admin-lesson-arrow">›</span></a></c:forEach><c:if test="${empty sections}"><div class="jl-card jl-admin-inline-empty">Chưa có phần luyện đề. Tạo phần thi trước khi thêm câu hỏi.</div></c:if></div>
  <div class="jl-admin-section-heading jl-admin-question-heading"><div><h2>Câu hỏi</h2><p class="jl-muted">Câu hỏi thuộc các phần bên trên.</p></div><a class="jl-btn" href="${ctx}/admin/questions/new?type=practice&amp;quiz_id=${quiz.id}">＋ Thêm câu hỏi</a></div>
  <div class="jl-table-wrap"><table class="jl-table"><thead><tr><th>#</th><th>Câu hỏi</th><th>Phần</th><th>Dạng</th><th>Điểm</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="question" items="${questions}"><tr><td><c:out value="${question.sortOrder}"/></td><td><c:out value="${question.content}"/></td><td><c:out value="${question.sectionTitle}"/></td><td><c:out value="${question.questionType}"/></td><td><c:out value="${question.points}"/></td><td><a href="${ctx}/admin/questions/${question.id}?type=practice&amp;quiz_id=${quiz.id}">Chỉnh sửa</a></td></tr></c:forEach><c:if test="${empty questions}"><tr><td colspan="6" class="jl-admin-empty">Chưa có câu hỏi. Thêm câu hỏi vào từng phần để hoàn thiện bộ luyện đề.</td></tr></c:if></tbody></table></div>
</main>
<jsp:include page="/WEB-INF/views/partials/admin_footer.jsp"/>
